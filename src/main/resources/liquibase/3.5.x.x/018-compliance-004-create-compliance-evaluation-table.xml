<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-004-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="compliance_evaluation_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="compliance_evaluation_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-004-create-compliance-evaluation-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="compliance_evaluation"/>
            </not>
        </preConditions>

        <createTable tableName="compliance_evaluation">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sample_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="standard_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="standard_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="evaluation_status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="overall_compliance" type="BOOLEAN"/>
            <column name="compliance_percentage" type="DECIMAL(5,2)"/>
            <column name="evaluated_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="evaluated_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="completed_date" type="TIMESTAMP"/>
            <column name="reviewed_date" type="TIMESTAMP"/>
            <column name="reviewed_by" type="VARCHAR(255)"/>
            <column name="evaluation_notes" type="TEXT"/>
            <column name="corrective_actions" type="TEXT"/>
            <column name="follow_up_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="follow_up_date" type="DATE"/>
            <column name="regulatory_notification_sent" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="notification_sent_date" type="TIMESTAMP"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="compliance_evaluation"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for common queries -->
    <changeSet id="compliance-004-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_evaluation"/>
        </preConditions>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_sample_id">
            <column name="sample_id"/>
        </createIndex>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_standard_id">
            <column name="standard_id"/>
        </createIndex>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_status">
            <column name="evaluation_status"/>
        </createIndex>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_date">
            <column name="evaluated_date"/>
        </createIndex>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_compliance">
            <column name="overall_compliance"/>
        </createIndex>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_follow_up">
            <column name="follow_up_required"/>
            <column name="follow_up_date"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_sample_id"/>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_standard_id"/>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_status"/>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_date"/>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_compliance"/>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_follow_up"/>
        </rollback>
    </changeSet>

    <!-- Add foreign key constraints -->
    <changeSet id="compliance-004-add-foreign-keys" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_evaluation"/>
            <tableExists tableName="compliance_standard"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_compliance_evaluation_standard"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="compliance_evaluation"
            baseColumnNames="standard_id"
            referencedTableName="compliance_standard"
            referencedColumnNames="id"
            constraintName="fk_compliance_evaluation_standard"
            onDelete="RESTRICT"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="compliance_evaluation" constraintName="fk_compliance_evaluation_standard"/>
        </rollback>
    </changeSet>

    <!-- Create composite index for version lock semantics -->
    <changeSet id="compliance-004-add-version-lock-index" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_evaluation"/>
            <not>
                <indexExists tableName="compliance_evaluation" indexName="idx_compliance_evaluation_version_lock"/>
            </not>
        </preConditions>

        <createIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_version_lock">
            <column name="sample_id"/>
            <column name="standard_id"/>
            <column name="standard_version"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="compliance_evaluation" indexName="idx_compliance_evaluation_version_lock"/>
        </rollback>
    </changeSet>

</databaseChangeLog>