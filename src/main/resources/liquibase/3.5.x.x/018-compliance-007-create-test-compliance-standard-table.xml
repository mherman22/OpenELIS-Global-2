<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-007-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="test_compliance_standard_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="test_compliance_standard_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-007-create-test-compliance-standard-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="test_compliance_standard"/>
            </not>
        </preConditions>

        <createTable tableName="test_compliance_standard">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="test_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="compliance_standard_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="applicable_parameters" type="TEXT"/>
            <column name="mandatory" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="VARCHAR(10)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="test_compliance_standard"/>
        </rollback>
    </changeSet>

    <!-- Create unique constraint to prevent duplicate test-standard associations -->
    <changeSet id="compliance-007-add-unique-constraint" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="test_compliance_standard"/>
            <not>
                <indexExists tableName="test_compliance_standard" indexName="uk_test_compliance_standard"/>
            </not>
        </preConditions>

        <addUniqueConstraint
            tableName="test_compliance_standard"
            columnNames="test_id, compliance_standard_id"
            constraintName="uk_test_compliance_standard"/>

        <rollback>
            <dropUniqueConstraint tableName="test_compliance_standard" constraintName="uk_test_compliance_standard"/>
        </rollback>
    </changeSet>

    <!-- Create foreign key constraints -->
    <changeSet id="compliance-007-add-foreign-keys" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="test_compliance_standard"/>
            <tableExists tableName="test"/>
            <tableExists tableName="compliance_standard"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_test_compliance_standard_test"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="test_compliance_standard"
            baseColumnNames="test_id"
            referencedTableName="test"
            referencedColumnNames="id"
            constraintName="fk_test_compliance_standard_test"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="test_compliance_standard"
            baseColumnNames="compliance_standard_id"
            referencedTableName="compliance_standard"
            referencedColumnNames="id"
            constraintName="fk_test_compliance_standard_compliance"
            onDelete="CASCADE"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="test_compliance_standard" constraintName="fk_test_compliance_standard_test"/>
            <dropForeignKeyConstraint baseTableName="test_compliance_standard" constraintName="fk_test_compliance_standard_compliance"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for efficient queries -->
    <changeSet id="compliance-007-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="test_compliance_standard"/>
        </preConditions>

        <createIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_test_id">
            <column name="test_id"/>
        </createIndex>

        <createIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_compliance_id">
            <column name="compliance_standard_id"/>
        </createIndex>

        <createIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_mandatory">
            <column name="mandatory"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_test_id"/>
            <dropIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_compliance_id"/>
            <dropIndex tableName="test_compliance_standard" indexName="idx_test_compliance_standard_mandatory"/>
        </rollback>
    </changeSet>

</databaseChangeLog>