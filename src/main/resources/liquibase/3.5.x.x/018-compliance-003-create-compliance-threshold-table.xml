<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-003-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="compliance_threshold_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="compliance_threshold_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-003-create-compliance-threshold-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="compliance_threshold"/>
            </not>
        </preConditions>

        <createTable tableName="compliance_threshold">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="group_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="parameter_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="threshold_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="min_value" type="DECIMAL(15,6)"/>
            <column name="max_value" type="DECIMAL(15,6)"/>
            <column name="target_value" type="DECIMAL(15,6)"/>
            <column name="units" type="VARCHAR(50)"/>
            <column name="method_reference" type="VARCHAR(255)"/>
            <column name="detection_limit" type="DECIMAL(15,6)"/>
            <column name="is_mandatory" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="validation_rules" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="compliance_threshold"/>
        </rollback>
    </changeSet>

    <!-- Create unique constraint for parameter code within group -->
    <changeSet id="compliance-003-add-unique-constraint" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_threshold"/>
            <not>
                <indexExists tableName="compliance_threshold" indexName="uk_threshold_parameter_per_group"/>
            </not>
        </preConditions>

        <addUniqueConstraint
            tableName="compliance_threshold"
            columnNames="group_id, parameter_code"
            constraintName="uk_threshold_parameter_per_group"/>

        <rollback>
            <dropUniqueConstraint tableName="compliance_threshold" constraintName="uk_threshold_parameter_per_group"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for common queries -->
    <changeSet id="compliance-003-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_threshold"/>
        </preConditions>

        <createIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_group_id">
            <column name="group_id"/>
        </createIndex>

        <createIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_sort_order">
            <column name="group_id"/>
            <column name="sort_order"/>
        </createIndex>

        <createIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_parameter">
            <column name="parameter_code"/>
        </createIndex>

        <createIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_type">
            <column name="threshold_type"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_group_id"/>
            <dropIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_sort_order"/>
            <dropIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_parameter"/>
            <dropIndex tableName="compliance_threshold" indexName="idx_compliance_threshold_type"/>
        </rollback>
    </changeSet>

    <!-- Add foreign key constraints -->
    <changeSet id="compliance-003-add-foreign-keys" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_threshold"/>
            <tableExists tableName="parameter_group"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_compliance_threshold_group"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="compliance_threshold"
            baseColumnNames="group_id"
            referencedTableName="parameter_group"
            referencedColumnNames="id"
            constraintName="fk_compliance_threshold_group"
            onDelete="CASCADE"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="compliance_threshold" constraintName="fk_compliance_threshold_group"/>
        </rollback>
    </changeSet>

    <!-- Add check constraints for threshold validation -->
    <changeSet id="compliance-003-add-check-constraints" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_threshold"/>
            <not>
                <checkConstraintExists constraintName="chk_threshold_min_max_range"/>
            </not>
        </preConditions>

        <sql>
            ALTER TABLE compliance_threshold
            ADD CONSTRAINT chk_threshold_min_max_range
            CHECK (
                (threshold_type = 'RANGE' AND min_value IS NOT NULL AND max_value IS NOT NULL AND min_value &lt;= max_value)
                OR (threshold_type = 'MINIMUM' AND min_value IS NOT NULL AND max_value IS NULL)
                OR (threshold_type = 'MAXIMUM' AND max_value IS NOT NULL AND min_value IS NULL)
                OR (threshold_type = 'TARGET' AND target_value IS NOT NULL)
                OR (threshold_type = 'EXACT' AND target_value IS NOT NULL)
            );
        </sql>

        <rollback>
            <sql>ALTER TABLE compliance_threshold DROP CONSTRAINT chk_threshold_min_max_range;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>