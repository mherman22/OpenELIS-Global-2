    <!-- ================================================================ -->
    <!-- UNIQUE CONSTRAINTS: Business rule enforcement                   -->
    <!-- ================================================================ -->

    <changeSet id="compliance-feature-add-unique-constraints" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="compliance_standard"/>
                <tableExists tableName="test_compliance_standard"/>
            </and>
        </preConditions>

        <!-- Natural key constraint for compliance standards -->
        <addUniqueConstraint
            tableName="compliance_standard"
            columnNames="issuing_body,regulation_number,version"
            constraintName="uk_compliance_standard_natural_key"/>

        <!-- Prevent duplicate test-standard associations -->
        <addUniqueConstraint
            tableName="test_compliance_standard"
            columnNames="test_id,compliance_standard_id"
            constraintName="uk_test_compliance_standard"/>

        <rollback>
            <dropUniqueConstraint tableName="test_compliance_standard" constraintName="uk_test_compliance_standard"/>
            <dropUniqueConstraint tableName="compliance_standard" constraintName="uk_compliance_standard_natural_key"/>
        </rollback>
    </changeSet>

    <!-- ================================================================ -->
    <!-- CHECK CONSTRAINTS: Data validation and enum enforcement         -->
    <!-- ================================================================ -->

    <changeSet id="compliance-feature-add-check-constraints" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="compliance_standard"/>
                <tableExists tableName="compliance_threshold"/>
                <tableExists tableName="compliance_evaluation"/>
                <tableExists tableName="compliance_import_log"/>
                <tableExists tableName="qc_compliance_rule"/>
            </and>
        </preConditions>

        <!-- Compliance Standard status constraint -->
        <sql>
            ALTER TABLE compliance_standard
            ADD CONSTRAINT chk_compliance_standard_status
            CHECK (status IN ('DRAFT', 'ACTIVE', 'SUPERSEDED', 'ARCHIVED', 'SUSPENDED'));
        </sql>

        <!-- Threshold type constraint -->
        <sql>
            ALTER TABLE compliance_threshold
            ADD CONSTRAINT chk_compliance_threshold_type
            CHECK (threshold_type IN ('RANGE', 'MINIMUM', 'MAXIMUM', 'EXACT', 'TARGET', 'NOT_DETECTED', 'QUALITATIVE'));
        </sql>

        <!-- Evaluation status constraint -->
        <sql>
            ALTER TABLE compliance_evaluation
            ADD CONSTRAINT chk_compliance_evaluation_status
            CHECK (evaluation_status IN ('PENDING', 'IN_PROGRESS', 'COMPLETED', 'REVIEWED', 'FAILED', 'CANCELLED', 'REQUIRES_RETEST'));
        </sql>

        <!-- Compliance percentage constraint -->
        <sql>
            ALTER TABLE compliance_evaluation
            ADD CONSTRAINT chk_compliance_evaluation_percentage
            CHECK (compliance_percentage IS NULL OR (compliance_percentage >= 0 AND compliance_percentage <= 100));
        </sql>

        <!-- Import log type constraint -->
        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_type
            CHECK (import_type IN ('CSV_FILE', 'MANUAL_ENTRY', 'LIQUIBASE_MIGRATION', 'API_IMPORT',
                                   'BULK_UPLOAD', 'SYSTEM_INITIALIZATION', 'EXTERNAL_SYNC', 'DATA_MIGRATION'));
        </sql>

        <!-- Import log status constraint -->
        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_status
            CHECK (import_status IN ('STARTED', 'IN_PROGRESS', 'COMPLETED', 'COMPLETED_WITH_WARNINGS',
                                     'FAILED', 'CANCELLED', 'TIMEOUT', 'QUEUED', 'VALIDATING',
                                     'VALIDATION_FAILED', 'ROLLING_BACK', 'ROLLED_BACK'));
        </sql>

        <!-- Import log counts constraint -->
        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_counts
            CHECK (records_processed >= 0 AND records_successful >= 0 AND
                   records_failed >= 0 AND records_skipped >= 0);
        </sql>

        <!-- Import log file size constraint -->
        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_file_size
            CHECK (file_size IS NULL OR file_size >= 0);
        </sql>

        <!-- QC rule evaluation frequency constraint -->
        <sql>
            ALTER TABLE qc_compliance_rule
            ADD CONSTRAINT chk_qc_compliance_rule_frequency
            CHECK (evaluation_frequency IN ('EVERY_RESULT', 'PER_RUN', 'DAILY', 'WEEKLY'));
        </sql>

        <!-- QC rule type constraint -->
        <sql>
            ALTER TABLE qc_compliance_rule
            ADD CONSTRAINT chk_qc_compliance_rule_type
            CHECK (qc_rule_type IN ('WESTGARD', 'CONTROL_CHART', 'TREND_ANALYSIS', 'LEVEY_JENNINGS',
                                   'CUSUM', 'MOVING_AVERAGE', 'RANGE', 'DUPLICATE', 'CUSTOM'));
        </sql>

        <rollback>
            <sql>ALTER TABLE compliance_standard DROP CONSTRAINT chk_compliance_standard_status</sql>
            <sql>ALTER TABLE compliance_threshold DROP CONSTRAINT chk_compliance_threshold_type</sql>
            <sql>ALTER TABLE compliance_evaluation DROP CONSTRAINT chk_compliance_evaluation_status</sql>
            <sql>ALTER TABLE compliance_evaluation DROP CONSTRAINT chk_compliance_evaluation_percentage</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_type</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_status</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_counts</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_file_size</sql>
            <sql>ALTER TABLE qc_compliance_rule DROP CONSTRAINT chk_qc_compliance_rule_frequency</sql>
            <sql>ALTER TABLE qc_compliance_rule DROP CONSTRAINT chk_qc_compliance_rule_type</sql>
        </rollback>
    </changeSet>

