<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-002-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="parameter_group_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="parameter_group_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-002-create-parameter-group-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="parameter_group"/>
            </not>
        </preConditions>

        <createTable tableName="parameter_group">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="standard_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="sort_order" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_mandatory" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="parameter_group"/>
        </rollback>
    </changeSet>

    <!-- Create unique constraint for group name within standard -->
    <changeSet id="compliance-002-add-unique-constraint" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="parameter_group"/>
            <not>
                <indexExists tableName="parameter_group" indexName="uk_parameter_group_name_per_standard"/>
            </not>
        </preConditions>

        <addUniqueConstraint
            tableName="parameter_group"
            columnNames="standard_id, name"
            constraintName="uk_parameter_group_name_per_standard"/>

        <rollback>
            <dropUniqueConstraint tableName="parameter_group" constraintName="uk_parameter_group_name_per_standard"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for common queries -->
    <changeSet id="compliance-002-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="parameter_group"/>
        </preConditions>

        <createIndex tableName="parameter_group" indexName="idx_parameter_group_standard_id">
            <column name="standard_id"/>
        </createIndex>

        <createIndex tableName="parameter_group" indexName="idx_parameter_group_sort_order">
            <column name="standard_id"/>
            <column name="sort_order"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="parameter_group" indexName="idx_parameter_group_standard_id"/>
            <dropIndex tableName="parameter_group" indexName="idx_parameter_group_sort_order"/>
        </rollback>
    </changeSet>

    <!-- Add foreign key constraint -->
    <changeSet id="compliance-002-add-foreign-keys" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="parameter_group"/>
            <tableExists tableName="compliance_standard"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_parameter_group_standard"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="parameter_group"
            baseColumnNames="standard_id"
            referencedTableName="compliance_standard"
            referencedColumnNames="id"
            constraintName="fk_parameter_group_standard"
            onDelete="CASCADE"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="parameter_group" constraintName="fk_parameter_group_standard"/>
        </rollback>
    </changeSet>

</databaseChangeLog>