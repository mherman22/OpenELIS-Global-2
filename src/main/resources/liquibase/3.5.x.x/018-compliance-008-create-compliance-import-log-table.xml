<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-008-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="compliance_import_log_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="compliance_import_log_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-008-create-compliance-import-log-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="compliance_import_log"/>
            </not>
        </preConditions>

        <createTable tableName="compliance_import_log">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="import_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="import_source" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="import_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="import_start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="import_end_time" type="TIMESTAMP"/>
            <column name="records_processed" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="records_successful" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="records_failed" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="records_skipped" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="import_summary" type="TEXT"/>
            <column name="error_details" type="TEXT"/>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="file_checksum" type="VARCHAR(64)"/>
            <column name="initiated_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="correlation_id" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="compliance_import_log"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for efficient queries -->
    <changeSet id="compliance-008-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_import_log"/>
        </preConditions>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_type">
            <column name="import_type"/>
        </createIndex>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_status">
            <column name="import_status"/>
        </createIndex>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_start_time">
            <column name="import_start_time"/>
        </createIndex>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_initiated_by">
            <column name="initiated_by"/>
        </createIndex>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_correlation_id">
            <column name="correlation_id"/>
        </createIndex>

        <createIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_file_checksum">
            <column name="file_checksum"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_type"/>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_status"/>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_start_time"/>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_initiated_by"/>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_correlation_id"/>
            <dropIndex tableName="compliance_import_log" indexName="idx_compliance_import_log_file_checksum"/>
        </rollback>
    </changeSet>

    <!-- Add check constraints for enum values -->
    <changeSet id="compliance-008-add-check-constraints" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="compliance_import_log"/>
        </preConditions>

        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_type
            CHECK (import_type IN ('CSV_FILE', 'MANUAL_ENTRY', 'LIQUIBASE_MIGRATION', 'API_IMPORT',
                                   'BULK_UPLOAD', 'SYSTEM_INITIALIZATION', 'EXTERNAL_SYNC', 'DATA_MIGRATION'));
        </sql>

        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_status
            CHECK (import_status IN ('STARTED', 'IN_PROGRESS', 'COMPLETED', 'COMPLETED_WITH_WARNINGS',
                                     'FAILED', 'CANCELLED', 'TIMEOUT', 'QUEUED', 'VALIDATING',
                                     'VALIDATION_FAILED', 'ROLLING_BACK', 'ROLLED_BACK'));
        </sql>

        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_counts
            CHECK (records_processed >= 0 AND records_successful >= 0 AND
                   records_failed >= 0 AND records_skipped >= 0);
        </sql>

        <sql>
            ALTER TABLE compliance_import_log
            ADD CONSTRAINT chk_compliance_import_log_file_size
            CHECK (file_size IS NULL OR file_size >= 0);
        </sql>

        <rollback>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_type</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_status</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_counts</sql>
            <sql>ALTER TABLE compliance_import_log DROP CONSTRAINT chk_compliance_import_log_file_size</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>