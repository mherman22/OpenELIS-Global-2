<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="compliance-005-create-sequence" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="evaluation_result_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="evaluation_result_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="compliance-005-create-evaluation-result-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="evaluation_result"/>
            </not>
        </preConditions>

        <createTable tableName="evaluation_result">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fhir_uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="evaluation_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="threshold_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="tested_value" type="DECIMAL(15,6)"/>
            <column name="tested_value_text" type="VARCHAR(255)"/>
            <column name="is_compliant" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="variance_from_target" type="DECIMAL(15,6)"/>
            <column name="variance_percentage" type="DECIMAL(5,2)"/>
            <column name="exceeded_by" type="DECIMAL(15,6)"/>
            <column name="measurement_method" type="VARCHAR(255)"/>
            <column name="measurement_date" type="TIMESTAMP"/>
            <column name="measurement_by" type="VARCHAR(255)"/>
            <column name="quality_flags" type="VARCHAR(255)"/>
            <column name="detection_limit_applied" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="result_notes" type="TEXT"/>
            <column name="validation_errors" type="TEXT"/>
            <column name="retest_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="retest_reason" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="archived_date" type="TIMESTAMP"/>
            <column name="sys_user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lastupdated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="evaluation_result"/>
        </rollback>
    </changeSet>

    <!-- Create unique constraint for one result per threshold per evaluation -->
    <changeSet id="compliance-005-add-unique-constraint" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="evaluation_result"/>
            <not>
                <indexExists tableName="evaluation_result" indexName="uk_result_threshold_per_evaluation"/>
            </not>
        </preConditions>

        <addUniqueConstraint
            tableName="evaluation_result"
            columnNames="evaluation_id, threshold_id"
            constraintName="uk_result_threshold_per_evaluation"/>

        <rollback>
            <dropUniqueConstraint tableName="evaluation_result" constraintName="uk_result_threshold_per_evaluation"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for common queries -->
    <changeSet id="compliance-005-create-indexes" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="evaluation_result"/>
        </preConditions>

        <createIndex tableName="evaluation_result" indexName="idx_evaluation_result_evaluation_id">
            <column name="evaluation_id"/>
        </createIndex>

        <createIndex tableName="evaluation_result" indexName="idx_evaluation_result_threshold_id">
            <column name="threshold_id"/>
        </createIndex>

        <createIndex tableName="evaluation_result" indexName="idx_evaluation_result_compliance">
            <column name="is_compliant"/>
        </createIndex>

        <createIndex tableName="evaluation_result" indexName="idx_evaluation_result_retest">
            <column name="retest_required"/>
        </createIndex>

        <createIndex tableName="evaluation_result" indexName="idx_evaluation_result_measurement_date">
            <column name="measurement_date"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="evaluation_result" indexName="idx_evaluation_result_evaluation_id"/>
            <dropIndex tableName="evaluation_result" indexName="idx_evaluation_result_threshold_id"/>
            <dropIndex tableName="evaluation_result" indexName="idx_evaluation_result_compliance"/>
            <dropIndex tableName="evaluation_result" indexName="idx_evaluation_result_retest"/>
            <dropIndex tableName="evaluation_result" indexName="idx_evaluation_result_measurement_date"/>
        </rollback>
    </changeSet>

    <!-- Add foreign key constraints -->
    <changeSet id="compliance-005-add-foreign-keys" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="evaluation_result"/>
            <tableExists tableName="compliance_evaluation"/>
            <tableExists tableName="compliance_threshold"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_evaluation_result_evaluation"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
            baseTableName="evaluation_result"
            baseColumnNames="evaluation_id"
            referencedTableName="compliance_evaluation"
            referencedColumnNames="id"
            constraintName="fk_evaluation_result_evaluation"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="evaluation_result"
            baseColumnNames="threshold_id"
            referencedTableName="compliance_threshold"
            referencedColumnNames="id"
            constraintName="fk_evaluation_result_threshold"
            onDelete="RESTRICT"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="evaluation_result" constraintName="fk_evaluation_result_evaluation"/>
            <dropForeignKeyConstraint baseTableName="evaluation_result" constraintName="fk_evaluation_result_threshold"/>
        </rollback>
    </changeSet>

    <!-- Add check constraints for value validation -->
    <changeSet id="compliance-005-add-check-constraints" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="evaluation_result"/>
            <not>
                <checkConstraintExists constraintName="chk_result_has_value"/>
            </not>
        </preConditions>

        <sql>
            ALTER TABLE evaluation_result
            ADD CONSTRAINT chk_result_has_value
            CHECK (tested_value IS NOT NULL OR tested_value_text IS NOT NULL);
        </sql>

        <rollback>
            <sql>ALTER TABLE evaluation_result DROP CONSTRAINT chk_result_has_value;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>