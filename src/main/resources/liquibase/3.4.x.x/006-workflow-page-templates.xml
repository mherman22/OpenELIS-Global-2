<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ======================================================== -->
    <!-- WORKFLOW PAGE TEMPLATES TABLE -->
    <!-- Predefined page templates for immunology workflow that users -->
    <!-- can select when configuring notebook templates -->
    <!-- ======================================================== -->

    <changeSet id="create-workflow-page-template-table" author="openelis-immunology">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workflow_page_template" schemaName="clinlims"/>
            </not>
        </preConditions>
        <comment>Create workflow_page_template table for predefined page templates</comment>

        <createTable tableName="workflow_page_template" schemaName="clinlims">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_key" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="default_instructions" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="default_content" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="page_type" type="VARCHAR(30)">
                <constraints nullable="true"/>
            </column>
            <column name="display_order" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="workflow_category" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createSequence sequenceName="workflow_page_template_seq" schemaName="clinlims" startValue="100"/>

        <rollback>
            <dropTable tableName="workflow_page_template" schemaName="clinlims"/>
            <dropSequence sequenceName="workflow_page_template_seq" schemaName="clinlims"/>
        </rollback>
    </changeSet>


</databaseChangeLog>
