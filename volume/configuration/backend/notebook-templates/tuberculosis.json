      "pageType": "generic_quality_check",
      "instructions": "Perform quality checks on raw samples. Verify sample condition, volume, and suitability for processing.",
      "content": "Raw Sample Quality Check (QC) - Quality assessment of incoming samples",
      "data": {
        "qcSections": [
          {
            "id": "sample_integrity",
            "title": "Sample Integrity",
            "criteria": [
              { "key": "leakCheck", "label": "No leaks / container intact", "criticalForPass": true },
              { "key": "temperatureCheck", "label": "Correct temperature on arrival", "criticalForPass": true },
              { "key": "packagingCheck", "label": "Proper packaging / triple packaging", "criticalForPass": false },
              { "key": "labelingCheck", "label": "Labeling accurate and legible", "criticalForPass": false },
              { "key": "volumeCheck", "label": "Adequate sample volume", "criticalForPass": true },
              { "key": "requestMatchCheck", "label": "Sample matches test request form", "criticalForPass": false }
            ]
          },
          {
            "id": "culture_qc",
            "title": "Culture QC",
            "criteria": [
              { "key": "cultureControlsIncluded", "label": "Positive and negative controls included", "criticalForPass": true },
              { "key": "contaminationRateAcceptable", "label": "Contamination rate within acceptable limits (<5%)", "criticalForPass": false }
            ]
          },
          {
            "id": "smear_microscopy_qc",
            "title": "Smear Microscopy QC",
            "criteria": [
              { "key": "smearControlsIncluded", "label": "Positive and negative smear controls included", "criticalForPass": true },
              { "key": "eqaParticipation", "label": "EQA participation up to date", "criticalForPass": false }
            ]
          },
          {
            "id": "genexpert_qc",
            "title": "GeneXpert QC",
            "criteria": [
              { "key": "geneXpertCalibrated", "label": "GeneXpert instrument calibrated", "criticalForPass": true },
              { "key": "geneXpertControlsRun", "label": "Module controls run and passed", "criticalForPass": true },
              { "key": "errorRateAcceptable", "label": "Error rate within acceptable limits", "criticalForPass": false }
            ]
          },
          {
            "id": "dst_qc",
            "title": "Drug Susceptibility Testing (DST) QC",
            "criteria": [
              { "key": "referenceStrainsTested", "label": "Reference strains (H37Rv) included", "criticalForPass": true },
              { "key": "micRangesVerified", "label": "MIC ranges within expected limits", "criticalForPass": true },
              { "key": "dstEqaParticipation", "label": "DST EQA participation up to date", "criticalForPass": false }
            ]
          }
        ],
        "qcResultOptions": [
