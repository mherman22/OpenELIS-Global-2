# OpenELIS Global Configuration (Secrets)
#
# IMPORTANT: This file contains sensitive information (credentials, API keys).
# DO NOT commit the actual common.properties file to version control.
#
# Copy this file to common.properties and fill in your actual values:
#   cp common.properties.example common.properties
#
# This file is then referenced in docker-compose.yml as a Docker secret:
#   secrets:
#     common.properties:
#       file: ./config/secrets/common.properties

# ============================================================================
# Database Configuration
# ============================================================================
# Note: Database credentials are passed via CATALINA_OPTS in docker-compose.yml
# datasource.url=jdbc:postgresql://db.openelis.org:5432/clinlims
# datasource.username=clinlims
# datasource.password=clinlims

# ============================================================================
# SSL/TLS Configuration (Tomcat Certificate Stores)
# ============================================================================
# Paths to keystore and truststore files (absolute paths inside container)
oe.ssl.keystorepath=/etc/openelis-global/keystore
oe.ssl.keystorepassword=kspass
oe.ssl.truststorepath=/etc/openelis-global/truststore
oe.ssl.truststorepassword=tspass

# ============================================================================
# Configuration Directory (Domain Configurations)
# ============================================================================
# Directory containing domain configurations (dictionaries, roles, templates, etc.)
# If empty or not present, defaults are loaded from classpath (recommended)
org.openelisglobal.configuration.dir=/var/lib/openelis-global/configuration/backend
org.openelisglobal.configuration.autocreate=true

# ============================================================================
# Menu Configuration
# ============================================================================
# Enable menu filtering via menu_config.json
org.openelisglobal.menu.configuration.autocreate=true

# ============================================================================
# FHIR Integration (Optional)
# ============================================================================
